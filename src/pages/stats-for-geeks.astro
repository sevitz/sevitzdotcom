---
export const prerender = true;

import HomeLayout from "../layouts/HomeLayout.astro";
import Footer from "../components/Footer.astro";
import Heatmap from "../components/stats/Heatmap.astro";
import Radar from "../components/stats/Radar.astro";
import RepoTable from "../components/stats/RepoTable.astro";
import LocChart from "../components/stats/LocChart.astro";
import { site } from "../data/site";
import { formatDate, formatNumber, stats } from "../lib/stats";

const { contributions } = stats;
---

<HomeLayout
  title={`Stats for geeks | ${site.hero.firstName} ${site.hero.lastName}`}
  description="Vanity stats from my GitHub repos: contributions, commits and lines of code over time."
>
  <div class="page-bar eyebrow">
    <a class="wordmark" href="/">{site.hero.wordmark}<span class="dot">.</span></a>
    <nav class="hero-nav" aria-label="Main">
      {site.nav.map((item) => <a href={item.href === "#contact" ? "/#contact" : item.href}>{item.label}</a>)}
    </nav>
  </div>
  <main class="page-main stats-main">
    <div>
      <p class="eyebrow" style="margin:0 0 20px;color:var(--accent)">Vanity metrics</p>
      <h1 class="page-title">Stats for geeks</h1>
    </div>
    <p class="page-lede">Numbers from my GitHub repos, rebuilt every week.</p>
    <p class="stats-updated">Last updated {formatDate(stats.generatedAt)}</p>

    <section class="stats-card" aria-labelledby="contrib-title">
      <h2 class="stats-card-title" id="contrib-title">
        {formatNumber(contributions.total)} contributions in the last year
        <span class="muted"><span class="sep" aria-hidden="true"> · </span>{formatNumber(contributions.repoCount)} repositories</span>
      </h2>
      <div class="stats-contrib">
        <Heatmap calendar={contributions.calendar} />
        <Radar breakdown={contributions.breakdown} />
      </div>
    </section>

    <section class="stats-card" aria-labelledby="repos-title">
      <h2 class="stats-card-title" id="repos-title">Repos</h2>
      <RepoTable repos={stats.repos} totals={stats.totals} weeks={stats.weeks} />
      <p class="stats-caption">Descriptions and links come from each repo's GitHub page. Click a clipped description to read the rest.</p>
    </section>

    <section class="stats-card" aria-labelledby="loc-title">
      <h2 class="stats-card-title" id="loc-title">Lines of code over time</h2>
      <LocChart weeks={stats.weeks} />
      {
        stats.weeks.length > 0 && (
          <p class="stats-caption">
            <span class="key-add">&#9632;</span> lines added &nbsp; <span class="key-rem">&#9632;</span> lines removed &nbsp; &mdash; total lines
          </p>
        )
      }
    </section>

    <p class="stats-caption">
      How this is counted: lines of text at the latest commit, excluding lockfiles, minified files, source maps, SVGs, build output and this page's own data
      file. Commits by anyone count, including AI-assisted ones. Totals cover only the repos I have approved for this page.
    </p>
  </main>
  <footer class="contact"><Footer /></footer>
</HomeLayout>
