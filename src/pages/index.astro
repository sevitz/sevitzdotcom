---
export const prerender = true;

import HomeLayout from "../layouts/HomeLayout.astro";
import Hero from "../components/Hero.astro";
import Links from "../components/Links.astro";
import Career from "../components/Career.astro";
import type { PostSummary } from "../components/Latest.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import { getPublishedPosts } from "../lib/thoughts";

// The 3 newest `status: published` Thoughts about posts; empty until one is published.
const posts: PostSummary[] = (await getPublishedPosts()).map(({ data }) => ({
  slug: data.slug,
  tag: data.tags[0] ?? "Note",
  title: data.title,
  summary: data.summary,
}));
---

<HomeLayout>
  <Hero />
  <main>
    <Career />
    <Links posts={posts.slice(0, 3)} />
    <About />
  </main>
  <Contact />
</HomeLayout>
