---
export const prerender = true;

import HomeLayout from "../layouts/HomeLayout.astro";
import Hero from "../components/Hero.astro";
import Links from "../components/Links.astro";
import Latest, { type PostSummary } from "../components/Latest.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";

// Filled from the Thoughts about content collection (docs/thoughts-about-plan.md,
// phase 2): the 3 newest `status: published` posts. Empty until then.
const posts: PostSummary[] = [];
---

<HomeLayout>
  <Hero />
  <main>
    <Links hasPosts={posts.length > 0} />
    <Latest posts={posts.slice(0, 3)} />
    <About />
  </main>
  <Contact />
</HomeLayout>
