---
export const prerender = true;

import HomeLayout from "../../layouts/HomeLayout.astro";
import Footer from "../../components/Footer.astro";
import PageBar from "../../components/PageBar.astro";
import { site } from "../../data/site";
import { formatDate, getPublishedPosts, postPath } from "../../lib/thoughts";

const posts = await getPublishedPosts();
---

<HomeLayout title={`Thoughts about… | ${site.hero.firstName} ${site.hero.lastName}`} rss>
  <PageBar />
  <main class="page-main">
    <p class="eyebrow" style="margin:0;color:var(--accent)">Writing</p>
    <h1 class="page-title">Thoughts about…</h1>
    {
      posts.length > 0 ? (
        <section class="all-posts" aria-labelledby="all-posts-label">
          <div class="section-head">
            <h2 class="section-label" id="all-posts-label">All posts</h2>
          </div>
          <ol class="post-list">
            {posts.map((post) => (
              <li>
                <a href={postPath(post)}>
                  <span class="post-side">
                    <span class="post-tag">{post.data.tags[0] ?? "Note"}</span>
                    <span class="post-meta">
                      {formatDate(post.data.date)}
                      {post.data.readingTimeMinutes && <br />}
                      {post.data.readingTimeMinutes && `${post.data.readingTimeMinutes} min read`}
                    </span>
                  </span>
                  <span class="post-body">
                    <span class="post-list-title">{post.data.title}</span>
                    <span class="post-list-summary">{post.data.summary}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ) : (
        <p class="page-lede">{site.links.thoughts.blurbEmpty}. First posts are on the way.</p>
      )
    }
  </main>
  <footer class="contact"><Footer /></footer>
</HomeLayout>
