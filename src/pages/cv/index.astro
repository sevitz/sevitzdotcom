---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { cv, standardCv, detailedCv } from "../../data/cv";
import { encode } from "../../lib/obfuscate";

const [phoneA, phoneB] = encode(cv.contact.phone.label);
const [emailLabelA, emailLabelB] = encode(cv.contact.email.label);
const [emailAddrA, emailAddrB] = encode(cv.contact.email.address);
---

<BaseLayout title={`${cv.name} - CV`}>
  <div class="cv-page" id="cv-page" data-mode="standard">
    <div class="cv-toolbar no-print">
      <a href="/#top" class="cv-back"><i class="fa fa-arrow-left"></i> Back to site</a>
      <div class="cv-toolbar-actions">
        <div class="cv-mode-switch" role="group" aria-label="CV version">
          <button type="button" class="cv-mode-btn is-active" data-mode-btn="standard">Standard</button>
          <button type="button" class="cv-mode-btn" data-mode-btn="detailed">Detailed</button>
        </div>
        <button type="button" class="cv-download" id="cv-download" onclick="window.print()">
          <i class="fa fa-file-pdf-o"></i> <span id="cv-download-label">Download Standard (PDF)</span>
        </button>
      </div>
    </div>

    <main class="cv-sheet" id="cv-sheet" data-mode="standard">
      <header class="cv-header">
        <h1>{cv.name}</h1>
        <p class="cv-headline">{cv.headline}</p>
        <p class="cv-contact">
          <span
            class="cv-field"
            data-kind="mailto"
            data-a={emailLabelA}
            data-b={emailLabelB}
            data-addr-a={emailAddrA}
            data-addr-b={emailAddrB}
            data-subject={cv.contact.email.subject}
          >
            <button type="button" class="cv-reveal">
              <span class="cv-reveal-desktop">Click for Email</span><span class="cv-reveal-touch">Tap for Email</span>
            </button>
          </span>
          <span aria-hidden="true">&nbsp;|&nbsp;</span>
          <span class="cv-field" data-kind="tel" data-a={phoneA} data-b={phoneB}>
            <button type="button" class="cv-reveal">
              <span class="cv-reveal-desktop">Click for Phone</span><span class="cv-reveal-touch">Tap for Phone</span>
            </button>
          </span>
          <span aria-hidden="true">&nbsp;|&nbsp;</span>
          <span>{cv.contact.location}</span>
          <span aria-hidden="true">&nbsp;|&nbsp;</span>
          <a href={cv.contact.linkedin.href} target="_blank" rel="noopener">{cv.contact.linkedin.label}</a>
        </p>
      </header>

      <div class="cv-variant cv-variant-standard">
        <section class="cv-section">
          {standardCv.summary.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section class="cv-section">
          <h2>Experience</h2>
          {standardCv.experience.map((job) => (
            <article class="cv-job">
              <h3>{job.company}</h3>
              {job.roles.map((role) => (
                <p class="cv-role">
                  <span class="cv-role-title">{role.title}</span>
                  <span class="cv-role-dates">{role.dates}</span>
                </p>
              ))}
              {job.note && <p class="cv-note">{job.note}</p>}
              <p class="cv-context">{job.context}</p>
              <p>{job.intro}</p>
              <ul>
                {job.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))}
        </section>

        <section class="cv-section">
          <h2>Earlier Career</h2>
          {standardCv.earlierCareer.map((line) => <p>{line}</p>)}
        </section>

        <section class="cv-section">
          <h2>Education</h2>
          {standardCv.education.map((line) => <p>{line}</p>)}
        </section>
      </div>

      <div class="cv-variant cv-variant-detailed">
        <section class="cv-section">
          {detailedCv.summary.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section class="cv-section">
          <h2>Career Highlights</h2>
          <ul>
            {detailedCv.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        </section>

        <section class="cv-section">
          <h2>Core Skills</h2>
          <p class="cv-skills">{detailedCv.coreSkills.join(" · ")}</p>
        </section>

        <section class="cv-section">
          <h2>Experience</h2>
          {detailedCv.experience.map((job) => (
            <article class="cv-job">
              <h3>{job.company}</h3>
              {job.context && <p class="cv-context">{job.context}</p>}
              {job.roles.map((role) => (
                <div class="cv-role-block">
                  <p class="cv-role">
                    <span class="cv-role-title">{role.title}</span>
                    <span class="cv-role-dates">{role.dates}</span>
                  </p>
                  {role.context && <p class="cv-context">{role.context}</p>}
                  {role.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
                  {role.bullets && (
                    <ul>
                      {role.bullets.map((bullet) => <li>{typeof bullet === "string" ? bullet : bullet.text}</li>)}
                    </ul>
                  )}
                  {role.achievements && (
                    <Fragment>
                      <p class="cv-achievements-heading">{role.achievements.heading}</p>
                      <ul>
                        {role.achievements.items.map((item) =>
                          typeof item === "string" ? (
                            <li>{item}</li>
                          ) : (
                            <li>
                              {item.text}
                              <ul>
                                {item.subBullets.map((subBullet) => <li>{subBullet}</li>)}
                              </ul>
                            </li>
                          )
                        )}
                      </ul>
                    </Fragment>
                  )}
                </div>
              ))}
            </article>
          ))}
        </section>

        <section class="cv-section">
          <h2>Earlier Career</h2>
          {detailedCv.earlierCareer.map((job) => (
            <article class="cv-job">
              <h3>{job.company}</h3>
              <p class="cv-role">
                <span class="cv-role-title">{job.role}</span>
                <span class="cv-role-dates">{job.dates}</span>
              </p>
              <ul>
                {job.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))}
        </section>

        <section class="cv-section">
          <h2>Education</h2>
          {detailedCv.education.map((edu) => (
            <div class="cv-edu-item">
              <p class="cv-role">
                <span class="cv-role-title">{edu.institution}</span>
                <span class="cv-role-dates">{edu.dates}</span>
              </p>
              <p class="cv-note">{edu.detail}</p>
            </div>
          ))}
        </section>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  // Mirrors src/lib/obfuscate.ts's encode() in reverse. Duplicated here
  // (rather than imported) since this runs client-side in the browser,
  // not in the Node build step obfuscate.ts is meant for. Also mirrored
  // in Contact.astro's client script for the same reason.
  function decode(a: string, b: string): string {
    const length = a.length + b.length;
    let reversed = "";
    for (let i = 0; i < length; i++) {
      reversed += i % 2 === 0 ? a[Math.floor(i / 2)] : b[Math.floor(i / 2)];
    }
    const shifted = reversed.split("").reverse().join("");
    return Array.from(shifted)
      .map((ch) => String.fromCharCode(ch.charCodeAt(0) - 1))
      .join("");
  }

  function buildRevealButton(kind: string | undefined): HTMLButtonElement {
    const label = kind === "tel" ? "Phone" : "Email";
    const button = document.createElement("button");
    button.type = "button";
    button.className = "cv-reveal";

    const desktop = document.createElement("span");
    desktop.className = "cv-reveal-desktop";
    desktop.textContent = `Click for ${label}`;

    const touch = document.createElement("span");
    touch.className = "cv-reveal-touch";
    touch.textContent = `Tap for ${label}`;

    button.append(desktop, touch);
    return button;
  }

  function attachClickHandler(field: HTMLElement, button: HTMLButtonElement) {
    button.addEventListener("click", () => revealField(field, { permanent: true }), { once: true });
  }

  function revealField(field: HTMLElement, { permanent }: { permanent: boolean }) {
    if (field.dataset.revealed === "true") return;

    const value = decode(field.dataset.a ?? "", field.dataset.b ?? "");
    const anchor = document.createElement("a");

    if (field.dataset.kind === "tel") {
      anchor.href = `tel:${value}`;
    } else {
      const address = decode(field.dataset.addrA ?? "", field.dataset.addrB ?? "");
      const subject = field.dataset.subject ?? "";
      anchor.href = `mailto:${encodeURIComponent(`Adrian Sevitz<${address}>`)}?subject=${encodeURIComponent(subject)}`;
    }
    anchor.textContent = value;

    field.replaceChildren(anchor);
    field.dataset.revealed = permanent ? "true" : "print";
  }

  // Only reverts a print-only reveal, never a value the visitor actually clicked to show.
  function hideField(field: HTMLElement) {
    if (field.dataset.revealed !== "print") return;

    const button = buildRevealButton(field.dataset.kind);
    field.replaceChildren(button);
    field.dataset.revealed = "false";
    attachClickHandler(field, button);
  }

  const fields = Array.from(document.querySelectorAll<HTMLElement>(".cv-field"));

  fields.forEach((field) => {
    const button = field.querySelector<HTMLButtonElement>(".cv-reveal");
    if (button) attachClickHandler(field, button);
  });

  window.addEventListener("beforeprint", () => {
    fields.forEach((field) => revealField(field, { permanent: false }));
  });
  window.addEventListener("afterprint", () => {
    fields.forEach((field) => hideField(field));
  });
</script>

<script>
  // Switches between the standard (2-page) and detailed (4-page) versions.
  // Both are rendered up front (see the .cv-variant-* blocks above); this
  // just flips which one is visible via data-mode, which the CSS and the
  // print output both key off.
  const page = document.getElementById("cv-page");
  const sheet = document.getElementById("cv-sheet");
  const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".cv-mode-btn"));
  const downloadLabel = document.getElementById("cv-download-label");

  const DOWNLOAD_LABEL: Record<string, string> = {
    standard: "Download Standard (PDF)",
    detailed: "Download Detailed (PDF)",
  };

  function setMode(mode: string) {
    if (!page || !sheet) return;
    page.dataset.mode = mode;
    sheet.dataset.mode = mode;
    modeButtons.forEach((button) => {
      button.classList.toggle("is-active", button.dataset.modeBtn === mode);
    });
    if (downloadLabel) downloadLabel.textContent = DOWNLOAD_LABEL[mode] ?? DOWNLOAD_LABEL.standard;
  }

  modeButtons.forEach((button) => {
    button.addEventListener("click", () => setMode(button.dataset.modeBtn ?? "standard"));
  });

  setMode(page?.dataset.mode ?? "standard");
</script>

<style is:global>
  .cv-page {
    --cv-accent: #e04343;
    background: #f3f5f8;
    min-height: 100vh;
    padding: 30px 16px 60px;
    font-family: "Open Sans", sans-serif;
  }
  .cv-page[data-mode="detailed"] {
    --cv-accent: #2f80ed;
  }

  .cv-toolbar {
    max-width: 800px;
    margin: 0 auto 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .cv-toolbar-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .cv-back {
    color: #545454;
    border-bottom: none;
    font-size: 14px;
  }
  .cv-back:hover {
    color: #e04343;
  }

  .cv-download {
    background: var(--cv-accent, #e04343);
    color: #fff;
    border: none;
    padding: 12px 24px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 13px;
    cursor: pointer;
    transition: background 0.3s;
  }
  .cv-download:hover {
    filter: brightness(0.9);
  }

  .cv-mode-switch {
    display: inline-flex;
    border: 2px solid #d8dbe0;
  }
  .cv-mode-btn {
    background: #fff;
    border: none;
    padding: 10px 22px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 13px;
    font-weight: bold;
    color: #8c9398;
    cursor: pointer;
    transition: all 0.3s;
  }
  .cv-mode-btn:first-child {
    border-right: 2px solid #d8dbe0;
  }
  .cv-mode-btn:not(.is-active):hover {
    background: #f3f5f8;
    color: #353535;
  }
  .cv-mode-btn[data-mode-btn="standard"].is-active {
    background: #e04343;
    color: #fff;
  }
  .cv-mode-btn[data-mode-btn="detailed"].is-active {
    background: #2f80ed;
    color: #fff;
  }

  .cv-sheet {
    max-width: 800px;
    margin: 0 auto;
    background: #fff;
    padding: 50px 60px;
    box-shadow: 0 3px 0 0 var(--cv-accent);
    color: #353535;
  }

  .cv-variant-detailed {
    display: none;
  }
  .cv-sheet[data-mode="detailed"] .cv-variant-standard {
    display: none;
  }
  .cv-sheet[data-mode="detailed"] .cv-variant-detailed {
    display: block;
  }

  .cv-header {
    text-align: center;
    margin-bottom: 30px;
  }
  .cv-header h1 {
    font-size: 32px;
    margin: 0 0 4px;
    letter-spacing: 1px;
    color: #353535;
  }
  .cv-headline {
    font-size: 15px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--cv-accent);
    margin: 0 0 10px;
  }
  .cv-contact {
    font-size: 13px;
    color: #8c9398;
    margin: 0;
  }
  .cv-contact a {
    color: #545454;
    border-bottom: none;
  }
  .cv-contact a:hover {
    color: var(--cv-accent);
  }
  .cv-field {
    display: inline;
  }
  .cv-field a {
    color: #545454;
    border-bottom: none;
  }
  .cv-field a:hover {
    color: var(--cv-accent);
  }
  .cv-reveal {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: var(--cv-accent);
    border-bottom: 1px dashed;
    cursor: pointer;
  }
  .cv-reveal:hover {
    color: #353535;
  }
  .cv-reveal-touch {
    display: none;
  }
  @media (hover: none) and (pointer: coarse) {
    .cv-reveal-desktop {
      display: none;
    }
    .cv-reveal-touch {
      display: inline;
    }
  }

  .cv-section {
    margin-bottom: 26px;
  }
  .cv-section h2 {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #353535;
    border-bottom: 2px solid var(--cv-accent);
    padding-bottom: 6px;
    margin: 0 0 14px;
  }
  /* global.css puts a generic ::after rule under every h2; this page draws its own rule */
  .cv-section h2::after {
    content: none;
  }
  .cv-section p {
    font-size: 13.5px;
    line-height: 1.6;
    color: #4a4a4a;
    margin: 0 0 10px;
  }
  .cv-section ul {
    margin: 8px 0 0;
    padding-left: 18px;
  }
  .cv-section li {
    font-size: 13.5px;
    line-height: 1.6;
    color: #4a4a4a;
    margin-bottom: 6px;
  }
  .cv-skills {
    text-align: center;
    font-weight: 600;
    color: #353535;
  }

  .cv-job {
    margin-bottom: 22px;
  }
  .cv-job:last-child {
    margin-bottom: 0;
  }
  .cv-job h3 {
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #353535;
    margin: 0 0 4px;
  }
  .cv-role-block {
    margin-bottom: 16px;
  }
  .cv-role-block:last-child {
    margin-bottom: 0;
  }
  .cv-role {
    display: flex;
    justify-content: space-between;
    font-size: 13.5px;
    margin: 0 0 2px;
  }
  .cv-role-title {
    font-weight: bold;
    color: #353535;
  }
  .cv-role-dates {
    color: #8c9398;
    white-space: nowrap;
    padding-left: 12px;
  }
  .cv-note {
    font-size: 13px;
    color: #8c9398;
    margin: 0 0 6px;
  }
  .cv-context {
    font-style: italic;
    color: #8c9398;
  }
  .cv-achievements-heading {
    font-size: 13px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #353535;
    margin: 10px 0 4px;
  }
  .cv-edu-item {
    margin-bottom: 14px;
  }
  .cv-edu-item:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    .cv-sheet {
      padding: 30px 22px;
    }
    .cv-role {
      flex-direction: column;
    }
    .cv-role-dates {
      padding-left: 0;
    }
  }

  @media print {
    .no-print {
      display: none !important;
    }
    .cv-page {
      background: #fff;
      padding: 0;
    }
    .cv-sheet {
      box-shadow: none;
      max-width: none;
      padding: 0;
    }
    a {
      color: inherit !important;
    }
    /* bootstrap's print stylesheet appends "(href)" after every link; too noisy for a CV */
    a[href]::after {
      content: none !important;
    }
  }
</style>
