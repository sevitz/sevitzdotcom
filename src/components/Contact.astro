---
import { site } from "../data/site";
import { encode } from "../lib/obfuscate";
import Footer from "./Footer.astro";

const { contact } = site;

const [phoneA, phoneB] = encode(contact.phone.label);
const [emailLabelA, emailLabelB] = encode(contact.email.label);
const [emailAddrA, emailAddrB] = encode(contact.email.address);
---

<footer class="contact" id="contact">
  <h2 class="sr-only">Contact</h2>
  <div class="contact-grid">
    <a class="contact-item" target="_blank" rel="noopener" href={contact.linkedin.href}>
      <span class="contact-label">LinkedIn</span>
      <span class="contact-value">{contact.linkedin.label}</span>
    </a>
    <button
      type="button"
      class="contact-item reveal"
      data-kind="mailto"
      data-a={emailLabelA}
      data-b={emailLabelB}
      data-addr-a={emailAddrA}
      data-addr-b={emailAddrB}
      data-subject={contact.email.subject}
    >
      <span class="contact-label">Email</span>
      <span class="contact-value reveal-text">Tap to reveal</span>
    </button>
    <button type="button" class="contact-item reveal" data-kind="tel" data-a={phoneA} data-b={phoneB}>
      <span class="contact-label">Phone</span>
      <span class="contact-value reveal-text">Tap to reveal</span>
    </button>
    <a class="contact-item" target="_blank" rel="noopener" href={contact.location.href}>
      <span class="contact-label">Location</span>
      <span class="contact-value">{contact.location.label}</span>
    </a>
  </div>
  <Footer />
</footer>

<script>
  // Mirrors src/lib/obfuscate.ts's encode() in reverse. Duplicated here
  // (rather than imported) since this runs client-side in the browser,
  // not in the Node build step obfuscate.ts is meant for.
  function decode(a: string, b: string): string {
    const length = a.length + b.length;
    let reversed = "";
    for (let i = 0; i < length; i++) {
      reversed += i % 2 === 0 ? a[Math.floor(i / 2)] : b[Math.floor(i / 2)];
    }
    const shifted = reversed.split("").reverse().join("");
    return Array.from(shifted)
      .map((ch) => String.fromCharCode(ch.charCodeAt(0) - 1))
      .join("");
  }

  document.querySelectorAll<HTMLButtonElement>(".reveal").forEach((button) => {
    button.addEventListener(
      "click",
      () => {
        const value = decode(button.dataset.a ?? "", button.dataset.b ?? "");

        const anchor = document.createElement("a");
        anchor.className = "contact-item";
        anchor.innerHTML = button.innerHTML;

        if (button.dataset.kind === "tel") {
          anchor.href = `tel:${value}`;
        } else {
          const address = decode(button.dataset.addrA ?? "", button.dataset.addrB ?? "");
          const subject = button.dataset.subject ?? "";
          anchor.href = `mailto:${encodeURIComponent(`Adrian Sevitz<${address}>`)}?subject=${encodeURIComponent(subject)}`;
        }

        const textEl = anchor.querySelector<HTMLElement>(".reveal-text");
        if (textEl) {
          textEl.textContent = value;
          textEl.classList.remove("reveal-text");
        }

        button.replaceWith(anchor);
        anchor.focus();
      },
      { once: true }
    );
  });
</script>
