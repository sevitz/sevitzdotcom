---
import { site } from "../data/site";
import { encode } from "../lib/obfuscate";

const { contact } = site;

const [phoneA, phoneB] = encode(contact.phone.label);
const [emailLabelA, emailLabelB] = encode(contact.email.label);
const [emailAddrA, emailAddrB] = encode(contact.email.address);
---

<section class="text-center section-padding contact-wrap" id="contact">
  <a href="#top" class="up-btn"><i class="fa fa-chevron-up"></i></a>
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <h1 class="arrow">Drop <span>me</span> a line</h1>
      </div>
    </div>
    <div class="row contact-details">
      <div class="col-md-5">
        <a target="_blank" rel="noopener" href={contact.location.href}>
          <div class="dark-box box-hover">
            <h2><i class="fa fa-map-marker"></i><span>Location</span></h2>
            <p><span class="aboxlink">{contact.location.label}&nbsp;{contact.location.flag}</span></p>
          </div>
        </a>
      </div>
      <div class="col-md-5">
        <button type="button" class="reveal-box" data-kind="tel" data-a={phoneA} data-b={phoneB}>
          <div class="dark-box box-hover">
            <h2><i class="fa fa-phone"></i><span>Phone</span></h2>
            <p><span class="aboxlink reveal-text">Tap to reveal</span></p>
          </div>
        </button>
      </div>
      <div class="col-md-5">
        <a target="_blank" rel="noopener" href={contact.linkedin.href}>
          <div class="dark-box box-hover">
            <h2><i class="fa fa-linkedin"></i><span>LinkedIn</span></h2>
            <p><span class="aboxlink">{contact.linkedin.label}</span></p>
          </div>
        </a>
      </div>
      <div class="col-md-5">
        <button
          type="button"
          class="reveal-box"
          data-kind="mailto"
          data-a={emailLabelA}
          data-b={emailLabelB}
          data-addr-a={emailAddrA}
          data-addr-b={emailAddrB}
          data-subject={contact.email.subject}
        >
          <div class="dark-box box-hover">
            <h2><i class="fa fa-paper-plane"></i><span>Email</span></h2>
            <p><span class="aboxlink reveal-text">Tap to reveal</span></p>
          </div>
        </button>
      </div>
      <div class="col-md-5">
        <a rel="nofollow noindex" href={contact.cv.href}>
          <div class="dark-box box-hover">
            <h2><i class="fa fa-file-pdf-o"></i><span>CV</span></h2>
            <p><span class="aboxlink">{contact.cv.label}</span></p>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Mirrors src/lib/obfuscate.ts's encode() in reverse. Duplicated here
  // (rather than imported) since this runs client-side in the browser,
  // not in the Node build step obfuscate.ts is meant for.
  function decode(a: string, b: string): string {
    const length = a.length + b.length;
    let reversed = "";
    for (let i = 0; i < length; i++) {
      reversed += i % 2 === 0 ? a[Math.floor(i / 2)] : b[Math.floor(i / 2)];
    }
    const shifted = reversed.split("").reverse().join("");
    return Array.from(shifted)
      .map((ch) => String.fromCharCode(ch.charCodeAt(0) - 1))
      .join("");
  }

  document.querySelectorAll<HTMLButtonElement>(".reveal-box").forEach((button) => {
    button.addEventListener(
      "click",
      () => {
        const value = decode(button.dataset.a ?? "", button.dataset.b ?? "");

        const anchor = document.createElement("a");
        anchor.innerHTML = button.innerHTML;

        if (button.dataset.kind === "tel") {
          anchor.href = `tel:${value}`;
        } else {
          const address = decode(button.dataset.addrA ?? "", button.dataset.addrB ?? "");
          const subject = button.dataset.subject ?? "";
          anchor.href = `mailto:${encodeURIComponent(`Adrian Sevitz<${address}>`)}?subject=${encodeURIComponent(subject)}`;
        }

        const textEl = anchor.querySelector<HTMLElement>(".reveal-text");
        if (textEl) {
          textEl.textContent = value;
          textEl.classList.remove("reveal-text");
        }

        button.replaceWith(anchor);
      },
      { once: true }
    );
  });
</script>
