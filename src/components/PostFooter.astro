---
import { historyUrl, sourceUrl } from "../lib/thoughts";

interface Props {
  folder: string;
  syndication?: { linkedin?: string; bluesky?: string; threads?: string };
}

const { folder, syndication = {} } = Astro.props;
const links = [
  { label: "Source on GitHub", href: sourceUrl(folder) },
  { label: "Edit history", href: historyUrl(folder) },
  ...(syndication.linkedin ? [{ label: "LinkedIn", href: syndication.linkedin }] : []),
  ...(syndication.bluesky ? [{ label: "Bluesky", href: syndication.bluesky }] : []),
  ...(syndication.threads ? [{ label: "Threads", href: syndication.threads }] : []),
];
---

<aside class="post-elsewhere" aria-labelledby="elsewhere-label">
  <h2 class="section-label" id="elsewhere-label">This post elsewhere</h2>
  <ul>
    {links.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}
  </ul>
</aside>
