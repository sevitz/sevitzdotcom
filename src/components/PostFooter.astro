---
import { sourceUrl } from "../lib/thoughts";

interface Props {
  folder: string;
  syndication?: { linkedin?: string; bluesky?: string; threads?: string };
}

const { folder, syndication = {} } = Astro.props;
const links = [
  { id: "github", label: "Source on GitHub", href: sourceUrl(folder) },
  ...(syndication.linkedin ? [{ id: "linkedin", label: "LinkedIn", href: syndication.linkedin }] : []),
  ...(syndication.bluesky ? [{ id: "bluesky", label: "Bluesky", href: syndication.bluesky }] : []),
  ...(syndication.threads ? [{ id: "threads", label: "Threads", href: syndication.threads }] : []),
