---

<aside class="post-elsewhere" aria-labelledby="elsewhere-label">
  <h2 class="section-label" id="elsewhere-label">This post elsewhere</h2>
  <ul>
    {links.map((l) => <li>
        <a href={l.href} rel="noopener">
          <svg
            class="elsewhere-icon"
            viewBox={icons[l.id].viewBox}
            aria-hidden="true"
            focusable="false"
            fill="currentColor"
          >
            <path d={icons[l.id].d} />
          </svg>
          {l.label}
        </a>
      </li>)}
  </ul>
</aside>
