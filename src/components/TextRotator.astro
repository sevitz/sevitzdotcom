---
interface Props {
  phrases: readonly string[];
}

const { phrases } = Astro.props;
---

<span class="rotate" data-phrases={JSON.stringify(phrases)}>{phrases[0]}</span>

<script>
  document.querySelectorAll<HTMLElement>(".rotate").forEach((el) => {
    const phrases: string[] = JSON.parse(el.dataset.phrases ?? "[]");
    if (phrases.length < 2) return;

    let index = 0;
    el.style.transition = "opacity 400ms";

    setInterval(() => {
      el.style.opacity = "0";
      setTimeout(() => {
        index = (index + 1) % phrases.length;
        el.textContent = phrases[index];
        el.style.opacity = "1";
      }, 400);
    }, 2000);
  });
</script>
