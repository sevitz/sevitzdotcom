---
import { clipDescription, formatDate, formatNumber, type RepoStat, type Stats } from "../../lib/stats";
import { relativeTime } from "../../lib/relative-time";
import Sparkline from "./Sparkline.astro";

interface Props {
  repos: RepoStat[];
  totals: Stats["totals"];
  weeks: Stats["weeks"];
}

const { repos, totals, weeks } = Astro.props;

const totalWeekly = weeks.map(({ added, removed }) => ({ added, removed }));
const nameOf = (r: RepoStat) => (r.kind === "retired" ? `Retired repos (${r.count ?? 0})` : r.label);
const latest = repos.map((r) => r.updated).filter((d): d is string => Boolean(d)).sort().at(-1);
const buildTime = new Date();
---

<div class="repo-table-wrap">
  <table class="repo-table">
    <thead>
      <tr>
        <th scope="col">Repo</th>
        <th scope="col" class="vis-col"><span class="sr-only">Visibility</span></th>
        <th scope="col">Description</th>
        <th scope="col" class="num">Commits</th>
        <th scope="col" class="num">Lines now</th>
        <th scope="col">Last Update</th>
        <th scope="col">Weekly Activity</th>
      </tr>
    </thead>
    <tbody>
      {
        repos.map((r) => {
          const desc = r.desc ? clipDescription(r.desc) : null;
          return (
            <tr class={r.visibility === "private" ? "is-private" : undefined}>
              <th scope="row" class="repo-name">
                {r.url ? (
                  <a href={r.url} rel="noopener">
                    {nameOf(r)}
                    <span class="ext" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                ) : (
                  nameOf(r)
                )}
              </th>
              <td class="vis-cell">
                {r.visibility === "private" ? (
                  <span class="vis" title="Private repo">
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                      <rect x="3" y="7" width="10" height="7" rx="1.6" fill="currentColor" />
                      <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                    <span class="sr-only">Private</span>
                  </span>
                ) : (
                  r.github && (
                    <a class="vis" href={r.github} rel="noopener" title="View on GitHub" aria-label={`${nameOf(r)} on GitHub`}>
                      <svg viewBox="0 0 16 16" aria-hidden="true">
                        <path
                          fill="currentColor"
                          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                        />
                      </svg>
                    </a>
                  )
                )}
              </td>
              <td>
                {desc &&
                  (desc.clipped ? (
                    <details class="repo-desc">
                      <summary>
                        <span class="d-short">{desc.short}…</span>
                        <span class="d-full">{r.desc}</span>
                        <span class="d-toggle">
                          <span class="t-more">more</span>
                          <span class="t-less">less</span>
                        </span>
                      </summary>
                    </details>
                  ) : (
                    <span class="repo-desc">{desc.short}</span>
                  ))}
              </td>
              <td class="num">{formatNumber(r.commits)}</td>
              <td class="num">{formatNumber(r.loc)}</td>
              <td class="updated">
                {r.updated && (
                  <time class="rel" datetime={r.updated} title={formatDate(r.updated)}>
                    {relativeTime(r.updated, buildTime)}
                  </time>
                )}
              </td>
              <td>
                <Sparkline weekly={r.weekly} label={nameOf(r)} />
              </td>
            </tr>
          );
        })
      }
    </tbody>
    <tfoot>
      <tr>
        <th scope="row" class="repo-name">Total ({totals.repos} repos)</th>
        <td />
        <td />
        <td class="num">{formatNumber(totals.commits)}</td>
        <td class="num">{formatNumber(totals.loc)}</td>
        <td class="updated">
          {latest && (
            <time class="rel" datetime={latest} title={formatDate(latest)}>
              {relativeTime(latest, buildTime)}
            </time>
          )}
        </td>
        <td>
          <Sparkline weekly={totalWeekly} label="All repos" />
        </td>
      </tr>
    </tfoot>
  </table>
</div>

<script>
  // The page is rebuilt only when the data changes, so refresh the wording against today's date in the browser.
  import { relativeTime } from "../../lib/relative-time";

  document.querySelectorAll<HTMLTimeElement>("time.rel").forEach((el) => {
    el.textContent = relativeTime(el.dateTime);
  });
</script>
