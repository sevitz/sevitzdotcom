---
import { site } from "../data/site";
import type { PostSummary } from "./Latest.astro";

interface Props {
  posts: PostSummary[];
}

const { posts } = Astro.props;
const { cv, thoughts, stats } = site.links;
---

<section class="start" aria-label="Start here">
  <div class="start-col">
    <div class="section-head">
      <h2 class="section-label">Start here</h2>
    </div>
    <ul class="start-list">
      <li>
        <a class="start-row start-cv" href={cv.href}>
          <span class="start-title">{cv.title}</span>
          <span class="start-blurb">Standard or detailed, as PDF</span>
          <span class="start-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
      <li>
        <a class="start-row" href={thoughts.href}>
          <span class="start-title">{thoughts.title}</span>
          <span class="start-blurb">Writing on technology and teams</span>
          <span class="start-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
      <li>
        <a class="start-row" href={stats.href}>
          <span class="start-title">{stats.title}</span>
          <span class="start-blurb">{stats.blurb}</span>
          <span class="start-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    </ul>
  </div>

  <div class="start-col start-latest" id="latest">
    <div class="section-head">
      <h2 class="section-label">Latest</h2>
      <a class="eyebrow" href={thoughts.href}>All →</a>
    </div>
    {
      posts.length > 0 ? (
        <ul class="start-list">
          {posts.map((post) => (
            <li>
              <a class="post-row" href={`${thoughts.href}${post.slug}/`}>
                <span class="post-tag">{post.tag}</span>
                <span class="post-title">{post.title}</span>
                <span class="post-summary">{post.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="posts-empty">First posts are on the way.</p>
      )
    }
  </div>
</section>
