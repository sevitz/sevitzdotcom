---
import { site } from "../data/site";
---

<section class="about" id="about" aria-labelledby="about-label">
  <h2 class="section-label" id="about-label">About</h2>
  <div class="about-copy">
    {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p class="about-footnote">{site.about.footnote}</p>
  </div>
</section>
