---
import pkg from "../../package.json";

let commit = (process.env.WORKERS_CI_COMMIT_SHA ?? process.env.CF_PAGES_COMMIT_SHA)?.slice(0, 7);
if (!commit) {
  try {
    const { execSync } = await import("node:child_process");
    commit = execSync("git rev-parse --short HEAD").toString().trim();
  } catch {
    commit = "dev";
  }
}
---

<nav class="footer-links" aria-label="More pages">
  <a href="/hero-images/">Hero images</a>
  <a href="/stats-for-geeks/">Stats for geeks</a>
</nav>
<p class="site-version">v{pkg.version} &middot; {commit}</p>
