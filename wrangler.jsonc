{
  // Static Astro site served as Worker static assets; no adapter needed.
  // Having this file stops `wrangler deploy` auto-config from running `astro add cloudflare`.
  "name": "sevitzdotcom",
  "compatibility_date": "2026-09-29",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  }
}
