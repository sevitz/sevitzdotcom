{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sevitzdotcom",
  "compatibility_date": "2026-09-29",
  // Every page is prerendered, so the Worker only serves the static build.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true,
  // Required for Worker Previews (`wrangler preview` on non-master branches).
  // Empty because the site has no bindings, vars or secrets.
  "previews": {}
}
